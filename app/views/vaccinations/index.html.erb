<div class="mb-8 flex items-center justify-between">
  <div>
    <h1 class="text-3xl font-bold text-slate-900">Vacunaciones</h1>
    <p class="mt-2 text-slate-600">Paciente: <%= @patient.name %></p>
  </div>
  <%= link_to "Registrar vacunación", new_patient_vaccination_path(@patient), class: "rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700" %>
</div>

<div class="grid gap-4 md:grid-cols-2">
  <% @vaccinations.each do |vaccination| %>
    <article class="rounded-lg bg-white p-5 shadow">
      <h2 class="text-xl font-bold text-slate-900"><%= vaccination.vaccine_name %></h2>
      <p class="mt-2 text-slate-600">Aplicada: <%= vaccination.applied_at %></p>
      <p class="text-slate-600">Próxima dosis: <%= vaccination.next_due_at %></p>
      <%= link_to "Ver", patient_vaccination_path(@patient, vaccination), class: "mt-4 inline-block font-semibold text-emerald-700" %>
    </article>
  <% end %>
</div>
