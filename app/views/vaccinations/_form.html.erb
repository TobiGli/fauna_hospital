<%= form_with model: [@patient, @vaccination], class: "space-y-6" do |form| %>
  <% if @vaccination.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-red-700">
      <%= pluralize(@vaccination.errors.count, "error") %> impidieron guardar la vacunación.
    </div>
  <% end %>

  <div>
    <%= form.label :vaccine_name, "Vacuna", class: "mb-2 block font-medium text-slate-700" %>
    <%= form.text_field :vaccine_name, class: "w-full rounded-lg border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
  </div>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :applied_at, "Fecha aplicada", class: "mb-2 block font-medium text-slate-700" %>
      <%= form.date_field :applied_at, class: "w-full rounded-lg border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
    </div>
    <div>
      <%= form.label :next_due_at, "Próxima dosis (opcional)", class: "mb-2 block font-medium text-slate-700" %>
      <%= form.date_field :next_due_at, class: "w-full rounded-lg border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
    </div>
  </div>

  <div>
    <%= form.label :dose, "Dosis", class: "mb-2 block font-medium text-slate-700" %>
    <%= form.number_field :dose, step: :any, min: 0, class: "w-full rounded-lg border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
  </div>

  <div>
    <%= form.label :notes, "Notas", class: "mb-2 block font-medium text-slate-700" %>
    <%= form.text_area :notes, rows: 4, class: "w-full rounded-lg border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
  </div>

  <%= form.submit "Guardar vacunación", class: "rounded-lg bg-emerald-600 px-5 py-2 font-semibold text-white hover:bg-emerald-700" %>
<% end %>
