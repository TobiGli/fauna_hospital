<div class="mb-8 flex items-center justify-between">
  <h1 class="text-3xl font-bold text-slate-900">Pacientes</h1>
  <%= link_to "Nuevo Paciente", new_patient_path, class: "rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700" %>
</div>

<%= form_with url: import_patients_path, multipart: true, class: "mb-6 flex items-center gap-4" do %>
  <%= file_field_tag :file, accept: ".csv", class: "rounded-lg border border-slate-300 p-2 text-sm text-slate-700 file:mr-4 file:rounded file:border-0 file:bg-emerald-50 file:px-4 file:py-2 file:font-semibold file:text-emerald-700 hover:file:bg-emerald-100" %>
  <%= submit_tag "Importar CSV", class: "rounded-lg bg-slate-700 px-4 py-2 font-semibold text-white hover:bg-slate-800" %>
<% end %>

<div class="grid gap-6 md:grid-cols-2 lg:grid-cols-3">
  <% @patients.each do |patient| %>
    <article class="rounded-lg bg-white p-6 shadow">
      <h2 class="text-xl font-bold text-slate-900"><%= patient.name %></h2>
      <p class="mt-2 text-slate-600"><%= patient.species.common_name %></p>
      <p class="mt-1 text-sm text-slate-500">Estado: <%= patient.status %></p>
      <%= link_to "Ver", patient_path(patient), class: "mt-4 inline-block font-semibold text-emerald-700 hover:text-emerald-900" %>
    </article>
  <% end %>
</div>
