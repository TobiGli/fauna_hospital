<div class="mb-8 flex items-start justify-between">
  <div>
    <h1 class="text-3xl font-bold text-slate-900"><%= @patient.name %></h1>
    <p class="mt-2 text-slate-600"><%= @patient.species.common_name %></p>
  </div>
  <%= link_to "Editar", edit_patient_path(@patient), class: "rounded-lg bg-slate-200 px-4 py-2 font-semibold text-slate-800 hover:bg-slate-300" %>
</div>

<section class="rounded-lg bg-white p-6 shadow">
  <h2 class="mb-4 text-xl font-bold text-slate-900">Datos del paciente</h2>
  <dl class="grid gap-4 sm:grid-cols-2">
    <div>
      <dt class="font-medium text-slate-500">Identificador</dt>
      <dd class="text-slate-900"><%= @patient.identifier %></dd>
    </div>
    <div>
      <dt class="font-medium text-slate-500">Estado</dt>
      <dd class="text-slate-900"><%= @patient.status %></dd>
    </div>
    <div>
      <dt class="font-medium text-slate-500">Fecha de admisión</dt>
      <dd class="text-slate-900"><%= @patient.admission_date %></dd>
    </div>
  </dl>

  <h3 class="mt-6 font-semibold text-slate-900">Métricas personalizadas</h3>
  <% if @patient.custom_metrics.present? %>
    <dl class="mt-2 grid gap-2 sm:grid-cols-2">
      <% @patient.custom_metrics.each do |key, value| %>
        <div class="rounded bg-slate-100 px-3 py-2">
          <dt class="text-sm font-medium text-slate-500"><%= key %></dt>
          <dd class="text-slate-900"><%= value %></dd>
        </div>
      <% end %>
    </dl>
  <% else %>
    <p class="mt-2 text-slate-500">No hay métricas registradas.</p>
  <% end %>
</section>

<section class="mt-8">
  <div class="mb-4 flex items-center justify-between">
    <h2 class="text-2xl font-bold text-slate-900">Historial Médico</h2>
    <%= link_to "Agregar Ficha Médica", new_patient_medical_record_path(@patient), class: "rounded-lg bg-emerald-600 px-4 py-2 font-semibold text-white hover:bg-emerald-700" %>
  </div>

  <div id="medical_records" class="grid gap-4 md:grid-cols-2">
    <%= render @patient.medical_records %>
  </div>
</section>
