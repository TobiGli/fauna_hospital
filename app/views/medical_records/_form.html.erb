<%= form_with model: [@patient, @medical_record], class: "space-y-6" do |form| %>
  <% if @medical_record.errors.any? %>
    <div class="rounded-lg bg-red-50 p-4 text-red-700">
      <%= pluralize(@medical_record.errors.count, "error") %> impidieron guardar esta ficha médica.
    </div>
  <% end %>

  <div class="grid gap-6 sm:grid-cols-2">
    <div>
      <%= form.label :weight, "Peso", class: "mb-2 block font-medium text-slate-700" %>
      <%= form.number_field :weight, step: :any, class: "w-full rounded-lg border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
    </div>

    <div>
      <%= form.label :temperature, "Temperatura", class: "mb-2 block font-medium text-slate-700" %>
      <%= form.number_field :temperature, step: :any, class: "w-full rounded-lg border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
    </div>
  </div>

  <div>
    <%= form.label :diagnosis, "Diagnóstico", class: "mb-2 block font-medium text-slate-700" %>
    <%= form.text_area :diagnosis, rows: 4, class: "w-full rounded-lg border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
  </div>

  <div>
    <%= form.label :treatment_plan, "Plan de tratamiento", class: "mb-2 block font-medium text-slate-700" %>
    <%= form.text_area :treatment_plan, rows: 4, class: "w-full rounded-lg border-slate-300 shadow-sm focus:border-emerald-500 focus:ring-emerald-500" %>
  </div>

  <%= form.submit "Guardar Ficha Médica", class: "rounded-lg bg-emerald-600 px-5 py-2 font-semibold text-white hover:bg-emerald-700" %>
<% end %>
