<article class="rounded-lg bg-white p-5 shadow">
  <p class="text-sm text-slate-500">Registrado el <%= medical_record.created_at.to_date %></p>
  <p class="mt-3 text-slate-700"><strong>Peso:</strong> <%= medical_record.weight %></p>
  <p class="text-slate-700"><strong>Temperatura:</strong> <%= medical_record.temperature %></p>
  <p class="mt-3 text-slate-700"><strong>Diagnóstico:</strong> <%= medical_record.diagnosis %></p>
  <p class="text-slate-700"><strong>Plan de tratamiento:</strong> <%= medical_record.treatment_plan %></p>
</article>
